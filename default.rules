prefix_rule(pattern=["npm", "install"], decision="allow")
prefix_rule(pattern=["npx", "playwright"], decision="allow")
prefix_rule(pattern=["npm", "run"], decision="allow")
prefix_rule(pattern=["./scripts/verify.sh"], decision="allow")
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="allow")
prefix_rule(pattern=["/usr/bin/zsh", "-lc", "HOME=/tmp/aozora-home BUNDLE_APP_CONFIG=.bundle BUNDLE_PATH=vendor/bundle BUNDLE_DISABLE_SHARED_GEMS=true BUNDLE_USER_HOME=/tmp/aozora-bundle BUNDLE_USER_CONFIG=/tmp/aozora-bundle/config BUNDLE_USER_CACHE=/tmp/aozora-bundle/cache ruby -e 'require \"bundler\"; require \"bundler/cli\"; Bundler::CLI.start([\"install\"])'"], decision="allow")
prefix_rule(pattern=["apt-get", "update"], decision="allow")
prefix_rule(pattern=["sudo", "apt-get", "update"], decision="allow")
prefix_rule(pattern=["ruby", "-e", "require \"bundler\"; require \"bundler/cli\"; Bundler::CLI.start([\"update\",\"nokogiri\"])"], decision="allow")
prefix_rule(pattern=["/usr/bin/zsh", "-lc", "HOME=/tmp/aozora-home BUNDLE_APP_CONFIG=.bundle BUNDLE_PATH=vendor/bundle BUNDLE_DISABLE_SHARED_GEMS=true BUNDLE_USER_HOME=/tmp/aozora-bundle BUNDLE_USER_CONFIG=/tmp/aozora-bundle/config BUNDLE_USER_CACHE=/tmp/aozora-bundle/cache ruby -e 'require \"bundler\"; require \"bundler/cli\"; Bundler::CLI.start([\"update\",\"nokogiri\"])'"], decision="allow")
prefix_rule(pattern=["/usr/bin/zsh", "-lc", "HOME=/tmp/aozora-home BUNDLE_APP_CONFIG=.bundle BUNDLE_PATH=vendor/bundle BUNDLE_DISABLE_SHARED_GEMS=true BUNDLE_USER_HOME=/tmp/aozora-bundle BUNDLE_USER_CONFIG=/tmp/aozora-bundle/config BUNDLE_USER_CACHE=/tmp/aozora-bundle/cache ruby -e 'require \"bundler\"; require \"bundler/cli\"; Bundler::CLI.start([\"lock\",\"--update\",\"nokogiri\"])'"], decision="allow")
prefix_rule(pattern=["bundle", "install"], decision="allow")
prefix_rule(pattern=["bundle", "exec", "ruby"], decision="allow")
prefix_rule(pattern=["curl", "-I"], decision="allow")
prefix_rule(pattern=["ss", "-ltnp"], decision="allow")
prefix_rule(pattern=["bundle", "exec", "bundler-audit"], decision="allow")
prefix_rule(pattern=["bundle", "update"], decision="allow")
